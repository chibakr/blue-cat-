<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Speed Wraith — AI Automation Studio</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #0b1f23; color: #d4e4e7; }
    a { text-decoration: none; color: inherit; }

    /* NAV */
    nav {
      display: flex; justify-content: space-between; align-items: center;
      max-width: 1100px; margin: 0 auto; padding: 24px 24px;
    }
    .logo { font-size: 20px; font-weight: 700; color: #C8A951; letter-spacing: 0.5px; }
    .nav-links { display: flex; gap: 32px; font-size: 14px; font-weight: 500; color: #a0b8bc; }
    .nav-links a:hover { color: #e8f0f1; }
    .nav-cta {
      padding: 10px 22px; background: #C8A951; color: #0b1f23;
      font-weight: 700; font-size: 14px; border-radius: 8px; border: none; cursor: pointer;
    }
    .nav-cta:hover { background: #d4b85e; }

    /* HERO */
    .hero {
      max-width: 1100px; margin: 0 auto; padding: 100px 24px 80px;
      text-align: center;
    }
    .hero-badge {
      display: inline-block; padding: 6px 16px; border-radius: 20px;
      background: rgba(200,169,81,0.12); color: #C8A951;
      font-size: 13px; font-weight: 600; margin-bottom: 24px;
    }
    .hero h1 {
      font-size: 52px; font-weight: 700; color: #e8f0f1;
      line-height: 1.15; max-width: 720px; margin: 0 auto 20px;
    }
    .hero h1 span { color: #C8A951; }
    .hero p {
      font-size: 18px; color: #7fa3a9; max-width: 540px;
      margin: 0 auto 40px; line-height: 1.6;
    }
    .hero-buttons { display: flex; gap: 16px; justify-content: center; }
    .btn-primary {
      padding: 16px 32px; background: #C8A951; color: #0b1f23;
      font-weight: 700; font-size: 16px; border-radius: 10px; border: none; cursor: pointer;
    }
    .btn-primary:hover { background: #d4b85e; }
    .btn-secondary {
      padding: 16px 32px; background: transparent; color: #d4e4e7;
      font-weight: 600; font-size: 16px; border-radius: 10px;
      border: 1px solid #1e5c66; cursor: pointer;
    }
    .btn-secondary:hover { border-color: #C8A951; color: #C8A951; }

    /* LOGOS */
    .logos {
      max-width: 1100px; margin: 0 auto; padding: 60px 24px;
      text-align: center; border-top: 1px solid #132e33;
    }
    .logos p { font-size: 13px; color: #5a7e84; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 28px; }
    .logo-row { display: flex; justify-content: center; gap: 48px; flex-wrap: wrap; align-items: center; }
    .logo-item { font-size: 18px; font-weight: 700; color: #2d5960; letter-spacing: 1px; }

    /* FEATURES */
    .features {
      max-width: 1100px; margin: 0 auto; padding: 80px 24px;
    }
    .features-header { text-align: center; margin-bottom: 60px; }
    .features-header h2 { font-size: 36px; font-weight: 700; color: #e8f0f1; margin-bottom: 12px; }
    .features-header p { font-size: 16px; color: #7fa3a9; max-width: 480px; margin: 0 auto; }
    .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .feature-card {
      background: #15454e; border-radius: 14px; padding: 36px 28px;
      border: 1px solid #1e5c66; transition: border-color 0.2s;
    }
    .feature-card:hover { border-color: #C8A951; }
    .feature-icon {
      width: 48px; height: 48px; border-radius: 12px;
      background: rgba(200,169,81,0.12); display: flex;
      align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 20px;
    }
    .feature-card h3 { font-size: 18px; font-weight: 700; color: #e8f0f1; margin-bottom: 10px; }
    .feature-card p { font-size: 14px; color: #7fa3a9; line-height: 1.6; }

    /* STATS */
    .stats {
      max-width: 1100px; margin: 0 auto; padding: 60px 24px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
      border-top: 1px solid #132e33; border-bottom: 1px solid #132e33;
    }
    .stat { text-align: center; }
    .stat-number { font-size: 42px; font-weight: 700; color: #C8A951; }
    .stat-label { font-size: 14px; color: #7fa3a9; margin-top: 4px; }

    /* CTA */
    .cta {
      max-width: 1100px; margin: 0 auto; padding: 100px 24px; text-align: center;
    }
    .cta-box {
      background: linear-gradient(135deg, #15454e 0%, #1a5a65 100%);
      border-radius: 20px; padding: 64px 40px;
      border: 1px solid #1e5c66;
    }
    .cta-box h2 { font-size: 36px; font-weight: 700; color: #e8f0f1; margin-bottom: 12px; }
    .cta-box p { font-size: 16px; color: #7fa3a9; max-width: 460px; margin: 0 auto 32px; }

    /* FOOTER */
    footer {
      max-width: 1100px; margin: 0 auto; padding: 40px 24px;
      display: flex; justify-content: space-between; align-items: center;
      border-top: 1px solid #132e33; font-size: 13px; color: #5a7e84;
    }
    .footer-links { display: flex; gap: 24px; }
    .footer-links a:hover { color: #C8A951; }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .hero h1 { font-size: 32px; }
      .features-grid { grid-template-columns: 1fr; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .nav-links { display: none; }
      .hero-buttons { flex-direction: column; align-items: center; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav>
    <div class="logo">Speed Wraith</div>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <a href="#about">About</a>
    </div>
    <button class="nav-cta">Get started</button>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-badge">Now accepting early access signups</div>
    <h1>Automate your business with <span>AI that actually works</span></h1>
    <p>We build custom AI workflows that save you hours every week. No code required. No monthly retainers. Just results.</p>
    <div class="hero-buttons">
      <button class="btn-primary">Book a free call</button>
      <button class="btn-secondary">See how it works</button>
    </div>
  </section>

  <!-- LOGOS -->
  <section class="logos">
    <p>Trusted by teams at</p>
    <div class="logo-row">
      <span class="logo-item">Acme Co</span>
      <span class="logo-item">Northstar</span>
      <span class="logo-item">Basecamp</span>
      <span class="logo-item">Wavelength</span>
      <span class="logo-item">Prism AI</span>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features" id="features">
    <div class="features-header">
      <h2>Everything you need to scale</h2>
      <p>From lead capture to client delivery, we automate the boring stuff so you can focus on growth.</p>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">&#9889;</div>
        <h3>Instant Lead Capture</h3>
        <p>Forms, chatbots, and landing pages that feed directly into your CRM. No manual entry.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128640;</div>
        <h3>AI-Powered Outreach</h3>
        <p>Personalized follow-ups sent automatically based on behavior, timing, and intent signals.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128200;</div>
        <h3>Real-Time Dashboards</h3>
        <p>See exactly what's working. Pipeline, conversion rates, and revenue — all in one place.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128274;</div>
        <h3>Secure by Default</h3>
        <p>SOC 2 compliant infrastructure. Your data stays yours. End-to-end encryption on every request.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128736;</div>
        <h3>Custom Workflows</h3>
        <p>We build automations around your process, not the other way around. Every workflow is tailored.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#129302;</div>
        <h3>AI Assistants</h3>
        <p>Deploy trained AI agents that handle scheduling, support tickets, and data entry 24/7.</p>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="stat">
      <div class="stat-number">12k+</div>
      <div class="stat-label">Workflows automated</div>
    </div>
    <div class="stat">
      <div class="stat-number">340</div>
      <div class="stat-label">Businesses served</div>
    </div>
    <div class="stat">
      <div class="stat-number">98%</div>
      <div class="stat-label">Client retention</div>
    </div>
    <div class="stat">
      <div class="stat-number">4.9</div>
      <div class="stat-label">Average rating</div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta-box">
      <h2>Ready to stop doing things manually?</h2>
      <p>Book a 15-minute call and we'll show you exactly what we can automate for your business.</p>
      <button class="btn-primary">Book a free call</button>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <span>&copy; 2026 Speed Wraith. All rights reserved.</span>
    <div class="footer-links">
      <a href="#">Privacy</a>
      <a href="#">Terms</a>
      <a href="#">Contact</a>
    </div>
  </footer>

</body>
</html>
